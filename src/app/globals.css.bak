@import "tailwindcss";
@import "../theme/tokens.css";

:root {
  /* מונע מדפדפנים (בעיקר כרום באנדרואיד) לכפות מצב כהה - האתר בעיצוב בהיר בלבד */
  color-scheme: light;
}

body {
  background: var(--color-bg);
  color: var(--color-ink);
  font-family: var(--font-sans);
}

/* אנימציית "פעימה" עדינה לכפתור התזכורת הצף של האונבורדינג/העדפות,
   כדי שהוא ימשוך תשומת לב בלי להיות מטריד. */
@keyframes fab-pulse {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.06);
  }
}
